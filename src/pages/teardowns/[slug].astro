---
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const entries = await getCollection('teardowns');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'teardowns'>;
}

const { entry } = Astro.props;
const { title, standfirst, subtitle, date, readTime, seoTitle, description, disclaimer, toc, downloads, cover, coverAlt } =
  entry.data;
const { Content } = await render(entry);

// The card image doubles as the link preview.
const og = await getImage({ src: cover, width: 1200, height: 630, format: 'png' });
---

<Base
  title={seoTitle}
  description={description}
  ogType="article"
  accent="var(--raspberry)"
  ogImage={{ src: og.src, alt: coverAlt }}
>
  <article class="container" id="top">
    <header class="page-head" data-reveal>
      <h1 class="title">{title}</h1>
      <p class="subtitle"><strong>{standfirst}</strong> {subtitle}</p>
      <p class="byline">By {SITE.name} · {date} · {readTime}</p>
      <p class="disclaimer">{disclaimer}</p>
      {
        downloads.length > 0 && (
          <div class="actions">
            {downloads.map((file, i) => (
              <a class:list={['button', { primary: i === 0 }]} href={file.href} download>
                {file.label}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="layout">
      <nav class="toc" aria-label="Contents">
        <p class="toc-title">Contents</p>
        <ol>
          {
            toc.map((item) => (
              <li>
                <a href={`#${item.id}`} data-section={item.id}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ol>
        <a class="toc-top" href="#top">Back to top</a>
      </nav>

      <div class="prose body">
        <Content />
      </div>
    </div>

    {
      downloads.length > 0 && (
        <div class="actions end">
          {downloads.map((file, i) => (
            <a class:list={['button', { primary: i === 0 }]} href={file.href} download>
              {file.label}
            </a>
          ))}
        </div>
      )
    }

    <p class="back">
      <a href="/teardowns">All teardowns</a>
      <a href="#top">Back to top</a>
    </p>
  </article>
</Base>

<style>
  .container {
    padding-top: var(--nav-offset);
  }

  /* Header */
  .page-head .title {
    max-width: 20ch;
  }

  .subtitle {
    max-width: var(--measure);
    margin-top: var(--space-5);
    font-size: var(--size-lead);
    line-height: 1.4;
    color: var(--muted);
  }

  .subtitle strong {
    color: var(--ink);
    font-weight: 600;
  }

  .byline {
    margin-top: var(--space-4);
    font-size: var(--size-label);
    font-weight: 500;
    color: var(--muted);
  }

  .disclaimer {
    max-width: var(--measure);
    margin-top: var(--space-5);
    padding-left: var(--space-4);
    border-left: 3px solid var(--hairline-strong);
    font-size: var(--size-small);
    font-style: italic;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .actions.end {
    margin-top: var(--space-8);
  }

  .back {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline);
    font-weight: 500;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  /* Contents beside the article on wide screens; on narrower ones the
     tracking-plan link in the TL;DR and Back to top do the job. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .toc {
    display: none;
  }

  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }

    .toc {
      position: sticky;
      top: calc(var(--nav-offset) + var(--space-4));
      display: block;
    }
  }

  .toc-title {
    margin-bottom: var(--space-3);
    font-size: var(--size-label);
    font-weight: 600;
    color: var(--ink);
  }

  .toc ol {
    border-left: 1px solid var(--hairline-strong);
  }

  .toc li a {
    display: block;
    margin-left: -1px;
    padding: var(--space-2) var(--space-3);
    border-left: 2px solid transparent;
    font-size: var(--size-label);
    font-weight: 500;
    line-height: 1.35;
    color: var(--slate);
    text-decoration: none;
  }

  .toc li a:hover,
  .toc li a[aria-current] {
    border-left-color: var(--cobalt);
    color: var(--cobalt);
  }

  .toc li a[href='#cup-race-tracking-plan'] {
    font-weight: 700;
    color: var(--ink);
  }

  .toc-top {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: var(--space-4);
    font-size: var(--size-label);
    font-weight: 500;
  }

  /* Article body. Text keeps a reading measure; tables, charts and the
     tracking plan take the full column. */
  .body {
    max-width: none;
  }

  .body > :global(:is(p, ul:not(.stats), ol:not(.stages), h3, blockquote)) {
    max-width: 62ch;
  }

  .body :global(h2) {
    margin-top: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--size-tile);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 32;
  }

  .body :global(h3) {
    margin-top: var(--space-6);
    font-size: var(--size-body);
    font-weight: 700;
    line-height: 1.35;
  }

  .body :global(h3 + *) {
    margin-top: var(--space-3);
  }

  .body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .body :global(:is(ul, ol):not(.stats, .bars, .stages)) {
    padding-left: 1.25em;
  }

  .body :global(ul:not(.stats, .bars, .stages) > li) {
    list-style: disc;
  }

  .body :global(ol:not(.stats, .bars, .stages) > li) {
    list-style: decimal;
  }

  .body :global(li + li) {
    margin-top: var(--space-2);
  }

  .body :global(li::marker) {
    color: var(--muted);
  }

  .body :global(code) {
    white-space: nowrap;
  }

  /* Callouts: The bet, The gap, Why it matters */
  .body :global(blockquote),
  .body :global(.callout) {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-m);
    background: var(--cobalt-tint);
    color: var(--ink);
    font-weight: 400;
  }

  /* TL;DR */
  .body :global(.tldr) {
    padding: var(--space-fluid-s);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-l);
    background: var(--white);
  }

  .body :global(.tldr > * + *) {
    margin-top: var(--space-4);
  }

  .body :global(.tldr h2) {
    margin-top: 0;
  }

  .body :global(.tldr h3) {
    margin-top: var(--space-5);
  }

  .body :global(.tldr > p:last-child a) {
    white-space: nowrap;
    font-weight: 600;
  }

  /* Tables: wrapped at build time so a wide one scrolls on a phone. */
  .body :global(.table-scroll) {
    overflow-x: auto;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-m);
    background: var(--white);
  }

  .body :global(table) {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: var(--size-small);
    line-height: 1.45;
  }

  .body :global(table:has(th:nth-child(5))) {
    min-width: 50rem;
  }

  .body :global(table:has(th:nth-child(6))) {
    min-width: 66rem;
  }

  .body :global(th),
  .body :global(td) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: top;
  }

  .body :global(th) {
    border-bottom: 1px solid var(--hairline-strong);
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .body :global(tr + tr td) {
    border-top: 1px solid var(--hairline);
  }

  .body :global(td:first-child) {
    color: var(--ink);
    font-weight: 500;
  }

  /* Stat tiles: a strip between two rules, like the home scorecard. */
  .body :global(.stats) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-block: 1px solid var(--hairline-strong);
  }

  @media (min-width: 720px) {
    .body :global(.stats) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .body :global(.stats li) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
  }

  .body :global(.stats strong) {
    font-family: var(--font-display);
    font-size: var(--size-tile);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 32;
  }

  .body :global(.stats span) {
    font-size: var(--size-label);
    line-height: 1.4;
    color: var(--muted);
  }

  /* Charts, drawn in HTML so the labels stay text and stay readable on a phone. */
  .body :global(.chart) {
    padding: var(--space-fluid-s);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-m);
    background: var(--white);
  }

  .body :global(.chart figcaption) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }

  .body :global(.chart-title) {
    color: var(--ink);
    font-weight: 700;
    line-height: 1.3;
  }

  .body :global(.chart-note) {
    font-size: var(--size-label);
    color: var(--muted);
  }

  .body :global(.bars li) {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    align-items: center;
    margin: 0;
  }

  .body :global(.bars li + li) {
    margin-top: var(--space-2);
  }

  .body :global(.bars.stacked li),
  .body :global(.bars li) {
    font-size: var(--size-label);
  }

  .body :global(.bars.stacked li) {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 640px) {
    .body :global(.bars li) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .body :global(.bar-label) {
    color: var(--slate);
    line-height: 1.3;
  }

  .body :global(.bar-track) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .body :global(.bar) {
    flex: 0 0 calc(var(--v) * 1.7%);
    height: 1rem;
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
    background: var(--hairline-strong);
  }

  .body :global(.hi .bar) {
    background: var(--cobalt);
  }

  .body :global(.bar-value) {
    color: var(--ink);
    font-weight: 600;
  }

  .body :global(.trend) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-5) var(--space-6);
  }

  .body :global(.trend-name) {
    margin-bottom: var(--space-3);
    color: var(--ink);
    font-weight: 600;
  }

  /* The five stages of the Cup Race plan, always visible. */
  .body :global(.stages) {
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-m);
    background: var(--white);
  }

  .body :global(.stages li) {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    grid-template-areas: 'name events' 'when events';
    gap: 0 var(--space-4);
    align-items: start;
    margin: 0;
    padding: var(--space-4) var(--space-5);
  }

  .body :global(.stages li + li) {
    border-top: 1px solid var(--hairline);
  }

  .body :global(.stage-name) {
    grid-area: name;
    color: var(--ink);
    font-weight: 700;
  }

  .body :global(.stage-when) {
    grid-area: when;
    font-size: var(--size-label);
    color: var(--muted);
  }

  .body :global(.stage-events) {
    grid-area: events;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .body :global(.stage-events code) {
    padding: var(--space-1) var(--space-2);
  }

  @media (max-width: 640px) {
    .body :global(.stages li) {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'name' 'when' 'events';
      gap: var(--space-2);
    }
  }

  /* The long event table folds away so the page stays scannable. */
  .body :global(details.more) {
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-m);
    background: var(--white);
  }

  .body :global(details.more > summary) {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: var(--space-3) var(--space-5);
    color: var(--ink);
    font-weight: 600;
    cursor: pointer;
  }

  .body :global(details.more > summary::before) {
    content: '+';
    display: inline-block;
    width: 1.25em;
    color: var(--cobalt);
    font-weight: 700;
  }

  .body :global(details.more[open] > summary::before) {
    content: '\2212';
  }

  .body :global(details.more > summary::-webkit-details-marker) {
    display: none;
  }

  .body :global(details.more > summary) {
    list-style: none;
  }

  .body :global(details.more[open] > summary) {
    border-bottom: 1px solid var(--hairline);
  }

  .body :global(details.more > :not(summary)) {
    margin: var(--space-4) var(--space-5);
  }

  .body :global(details.more .table-scroll) {
    margin-inline: 0;
    border: 0;
    border-radius: 0;
    border-bottom: 1px solid var(--hairline);
  }
</style>
