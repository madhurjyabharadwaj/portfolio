---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TeardownCard from '../../components/TeardownCard.astro';
import { TEARDOWNS_INTRO as intro, byOrder } from '../../lib/work';

const teardowns = (await getCollection('teardowns')).sort(byOrder);
---

<Base title="Product Teardowns · Madhurjya Bharadwaj" description={intro} accent="var(--raspberry)">
  <div class="container">
    <header class="page-head" data-reveal>
      <h1 class="title">Product Teardowns</h1>
      <p class="lead">{intro}</p>
    </header>

    <ul class="cards">
      {
        teardowns.map((entry) => (
          <li data-reveal>
            <TeardownCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .container {
    padding-top: var(--nav-offset);
  }

  .cards {
    display: grid;
    gap: var(--space-5);
  }
</style>
