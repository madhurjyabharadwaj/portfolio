---
import Base from '../layouts/Base.astro';

const leverage = [
  {
    title: 'Discovery that starts with the user',
    text: "Sitting with the people who use the product before writing a line of the PRD. The brief tells you what someone wants built. The user tells you what's actually broken.",
  },
  {
    title: 'Evidence before opinion',
    text: 'Data used to settle arguments, not decorate them. I try to agree the metric before we build anything, because agreeing it afterwards never goes well.',
  },
  {
    title: 'I can build it myself',
    text: "Live, documented, open-source products, written and shipped end to end. It keeps me honest about what's hard to build and what only sounds hard, and it makes engineering conversations shorter.",
  },
  {
    title: 'Delivery that survives contact with production',
    text: "PRDs, backlog, UAT, governance, cutover, then reliability once it's live. Nobody thanks you for a rollout that goes smoothly, and that's rather the point.",
  },
];

const education = [
  {
    dates: '2023 to 2026',
    place: 'Paris, France',
    degree: 'Master in Management (Grande École)',
    school: 'ESSEC Business School',
  },
  {
    dates: '2016 to 2020',
    place: 'India',
    degree: 'B.Tech',
    school: 'Vellore Institute of Technology',
  },
];
---

<Base
  title="About · Madhurjya Bharadwaj"
  description="Engineer by training. Product manager by choice. I trained as an engineer and came out of it more interested in why things get built than in whether they stand up."
  accent="var(--butter)"
>
  <div class="container about">
    <div class="about-main" data-reveal>
      <p class="eyebrow with-rule">About me</p>
      <h1 class="title">Engineer by training. Product manager by choice.</h1>
      <p class="lead">
        I trained as an engineer and came out of it more interested in why things get built than in whether
        they stand up.
      </p>
      <div class="prose">
        <p>
          I work at the point where what a user needs, what engineering can build, and what the business will
          pay for all meet. Most of my career has been spent getting those three to agree. The last two years
          of it were spent owning an enterprise system from the first PRD through a zero-downtime cutover and
          into production, which is a different kind of hard from shipping a feature and moving on.
        </p>
        <p>
          Before product I did analytics and consulting, so I don't take a metric on trust, and I'm happy to go
          into the data myself. And because I build and deploy my own products, I have a fairly honest sense of
          the distance between deciding something in a meeting and having it work on someone's screen.
        </p>
      </div>
      <section class="education" aria-labelledby="education">
        <h2 id="education" class="eyebrow">Education</h2>
        <ol class="schools">
          {
            education.map((item) => (
              <li class="school">
                <div class="school-when">
                  <p class="dates">{item.dates}</p>
                  <p class="place">{item.place}</p>
                </div>
                <div class="school-what">
                  <h3>{item.degree}</h3>
                  <p class="school-name">{item.school}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <aside class="about-side" aria-labelledby="leverage">
      <p id="leverage" class="eyebrow with-rule">How I create leverage</p>
      <ul class="leverage" data-reveal-group>
        {
          leverage.map((item) => (
            <li>
              <span class="dot" aria-hidden="true" />
              <div>
                <h2>{item.title}</h2>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>

</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    padding-top: calc(var(--nav-offset) + clamp(1.5rem, 5vw, 4rem));
  }

  .about-main > * + * {
    margin-top: 1.5rem;
  }

  .about-main .title {
    margin-top: 1rem;
    max-width: 16ch;
  }

  .about-main .title::after {
    content: '';
    display: block;
    width: 3rem;
    height: 0.5rem;
    margin-top: 1.25rem;
    border-radius: 2px;
    background: var(--accent, var(--ink));
  }

  .about-main .lead {
    color: var(--ink);
    font-weight: 500;
  }

  .education {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  /* Education mirrors an Experience entry: dates and place on the left,
     qualification and school on the right. */
  .schools {
    margin-top: 0.5rem;
  }

  .school {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1rem;
  }

  .school + .school {
    border-top: 1px solid var(--hairline);
  }

  .school .dates {
    font-size: var(--size-label);
    font-weight: 600;
    color: var(--ink);
  }

  .school .place {
    margin-top: 0.15rem;
    font-size: var(--size-label);
    font-weight: 500;
    color: var(--muted);
  }

  .school h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .school-name {
    margin-top: 0.15rem;
    color: var(--cobalt);
  }

  @media (max-width: 480px) {
    .school {
      grid-template-columns: 1fr;
    }

    .school-what {
      margin-top: 0.4rem;
    }
  }

  .about-side {
    /* Line up the aside heading with the main eyebrow, then let the cards run. */
    padding-top: 0;
  }

  .leverage {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .leverage li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-tile);
    background: var(--white);
  }

  .leverage .dot {
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--cobalt);
  }

  .leverage h2 {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .leverage p {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--slate);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about-side {
      padding-top: 1rem;
    }
  }
</style>
