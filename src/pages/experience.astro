---
import Base from '../layouts/Base.astro';

const jobs = [
  {
    role: 'Product Manager',
    company: 'Air Liquide',
    dates: 'Nov 2024 to Sep 2026',
    sector: 'Industrial gases',
    problem: 'A legacy enterprise system used by field teams across Europe had to be replaced without interrupting the work that ran on it.',
    action: 'Ran discovery with the teams who used it daily, wrote the PRDs, owned the backlog, and set up user acceptance testing across several European teams with test books that told testers what to check and what to flag.',
    product: 'A replacement system taken from discovery to live, plus a role-based secure access feature that unblocked a contractual-data workflow nobody had picked up, cleared through Legal and IT governance.',
    outcome: 'Zero-downtime cutover. System in daily use across European field teams. Monthly reporting automated into Power BI, cutting manual effort by around 40%.',
    tags: ['Enterprise', 'Build and run', 'UAT', 'Change management', 'Power BI'],
  },
  {
    role: 'Data Product Owner',
    company: "L'Oréal",
    dates: 'Jan 2024 to Jun 2024',
    sector: 'Beauty',
    problem: 'Market-share reporting across the Top 20 markets was fragmented, category definitions disagreed between consolidators, and a thousand-plus brands were being mapped to business categories by hand.',
    action: 'Wrote the user stories and ran the backlog to bring Kantar, Nielsen and B2B sources into AWS, and reconciled category definitions across more than 20 markets into one comparable view.',
    product: 'A standardised set of Power BI dashboards for the Top 20 markets, and an AI fuzzy-matching agent that allocates 1,000+ brands across four universes automatically.',
    outcome: 'Manual brand mapping retired. Near real-time portfolio visibility for the business. A recurring blocker in executive revenue reviews removed.',
    tags: ['AI agents', 'Data products', 'AWS', 'Power BI'],
  },
  {
    role: 'Business Analyst',
    company: 'Spinny',
    dates: 'Feb 2023 to Jun 2023',
    sector: 'Automotive e-commerce',
    problem: 'Buyers were dropping between showroom visit and token payment in the Hub app, and a quarter of deliveries were being cancelled after the deposit had already been paid.',
    action: 'Ran discovery with showroom staff who used the app every day, then mined CRM leads data to rebuild the token-to-delivery journey and find where cancellations came from.',
    product: 'A redesigned visit-to-token flow, and a ranked list of cancellation drivers handed to the closure team to run win-back against.',
    outcome: 'Visit-to-token conversion up 10%. Delivery cancellations down 25%.',
    tags: ['Discovery', 'Funnel', 'SQL', 'Consumer'],
  },
  {
    role: 'Associate',
    company: 'ZoomRx',
    dates: 'May 2021 to Jan 2023',
    sector: 'Life sciences consulting',
    problem: 'Pharma clients including Janssen, GSK and Sanofi needed to know how their brands were performing against named rivals and whether a new launch would win share or eat their own.',
    action: 'Ran competitive benchmarking on brand reach, share of voice, message effectiveness and sales-rep effectiveness. Scoped go-to-market and launch studies, including cannibalisation analysis.',
    product: 'Promotional recommendations and launch reads that clients used to decide spend and positioning.',
    outcome: 'Two years of turning contradictory evidence into something a client could act on, which turned out to be most of the product job too.',
    tags: ['Strategy', 'Life sciences', 'Go-to-market'],
  },
];

const steps = [
  ['Problem', 'problem'],
  ['Action', 'action'],
  ['Product', 'product'],
  ['Outcome', 'outcome'],
] as const;
---

<Base
  title="Experience · Madhurjya Bharadwaj"
  description="Four roles, four sectors, and a fairly straight line through them. Life sciences consulting, analytics at an automotive marketplace, data product ownership in beauty, and two years owning an enterprise system in heavy industry from discovery to production."
  accent="var(--cobalt)"
>
  <div class="container">
    <header class="page-head" data-reveal>
      <h1 class="title">Experience</h1>
      <p class="lead">
        Four roles, four sectors, and a fairly straight line through them. I started in life sciences
        consulting, turning contradictory market evidence into recommendations a client could act on. Then
        analytics at an automotive marketplace, where I ended up doing product work under a different job
        title and decided to make the move properly. Since then it's been data product ownership in beauty,
        and two years owning an enterprise system in heavy industry from discovery to production.
      </p>
      <p class="intro-note">
        Each role below is written the same way: the problem I walked into, what I did about it, what I
        owned, and what changed. If you only read one line per role, read the last one.
      </p>
    </header>

    <ol class="jobs" data-reveal-group>
      {
        jobs.map((job) => (
          <li class="job">
            <div class="job-when">
              <span class="node" aria-hidden="true" />
              <p class="dates">{job.dates}</p>
              <p class="sector">{job.sector}</p>
            </div>
            <div class="job-what">
              <h2>
                {job.role} <span class="company">{job.company}</span>
              </h2>
              <dl class="steps">
                {steps.map(([label, key]) => (
                  <div class:list={['step', { outcome: key === 'outcome' }]}>
                    <dt>{label}</dt>
                    <dd>{job[key]}</dd>
                  </div>
                ))}
              </dl>
              <ul class="tags" aria-label="Themes">
                {job.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .container {
    padding-top: var(--nav-offset);
  }

  .intro-note {
    max-width: var(--measure);
    margin-top: 1.25rem;
    color: var(--muted);
  }

  /* A single rail runs down the left, one node per role. */
  .jobs {
    position: relative;
    margin-top: 1rem;
    padding-left: 2rem;
  }

  .jobs::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 0.4375rem;
    width: 2px;
    background: var(--cobalt);
    transform-origin: top;
  }

  /* The rail draws itself and each node fills as the list moves up the
     viewport. Browsers without scroll-driven animations see the finished state. */
  @supports (animation-timeline: view()) {
    .jobs::before {
      animation: draw-rail linear both;
      animation-timeline: view();
      animation-range: entry 10% exit 60%;
    }

    .node {
      animation: fill-node linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 40%;
    }

    @keyframes draw-rail {
      from {
        transform: scaleY(0);
      }
      to {
        transform: scaleY(1);
      }
    }

    @keyframes fill-node {
      from {
        background: var(--frost);
        transform: scale(0.8);
      }
      to {
        background: var(--cobalt);
        transform: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jobs::before,
    .node {
      animation: none;
    }
  }

  .job {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr);
    gap: 1rem clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--hairline);
  }

  .job:last-child {
    border-bottom: 0;
  }

  .node {
    position: absolute;
    top: 0.45rem;
    left: -2rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 3px solid var(--cobalt);
    background: var(--frost);
  }

  .job:first-child .node {
    background: var(--cobalt);
  }

  .job:first-child .node {
    animation: none;
  }

  .job-when {
    position: relative;
  }

  .dates {
    font-weight: 600;
    color: var(--ink);
  }

  .sector {
    margin-top: 0.25rem;
    font-size: var(--size-label);
    font-weight: 500;
    color: var(--muted);
  }

  .job-what h2 {
    font-size: var(--size-subhead);
    font-weight: 600;
    line-height: 1.3;
  }

  .company {
    display: block;
    font-weight: 400;
    color: var(--cobalt);
  }

  /* Problem / Action / Product / Outcome as a labelled strip. */
  .steps {
    display: grid;
    gap: 0.9rem;
    max-width: var(--measure);
    margin-top: 1.5rem;
  }

  .step {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .step dt {
    padding-top: 0.15em;
    font-size: var(--size-label);
    font-weight: 600;
    color: var(--muted);
  }

  .step dd {
    margin: 0;
  }

  .step.outcome {
    padding-top: 0.9rem;
    border-top: 1px solid var(--hairline);
  }

  .step.outcome dt {
    color: var(--cobalt);
  }

  .step.outcome dd {
    font-weight: 500;
    color: var(--ink);
  }

  .job-what .tags {
    margin-top: 1.5rem;
  }

  @media (max-width: 720px) {
    .job {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .step {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
