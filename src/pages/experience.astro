---
import Base from '../layouts/Base.astro';

const jobs = [
  {
    role: 'Product Manager Apprentice',
    company: 'Air Liquide',
    meta: 'Nov 2024 to Sep 2026 · Paris · Industrial gases, €27B revenue',
    paragraphs: [
      'Took a replacement enterprise system from discovery to live, owning the PRDs, the backlog and the rollout, then keeping ownership of reliability once it was running. Cutover happened with zero downtime and the system is in use across European field teams.',
      'Shipped a role-based secure access feature that unblocked a contractual-data workflow nobody had picked up before, by spotting the gap in a regional team and getting it through Legal and IT governance.',
      'Ran user acceptance testing for a major upgrade. That meant choosing the right testers across several European teams, writing the test books that told them what to check and what to flag, and validating what came back before go-live.',
      'Automated monthly reporting into a Power BI dashboard pulling from several operational sources, which cut the manual effort by around 40% and gave leadership live KPI visibility.',
    ],
    tags: ['Enterprise', 'Build and run', 'Change management', 'Power BI', 'UAT'],
  },
  {
    role: 'Data Product Owner Intern',
    company: "L'Oréal",
    meta: 'Jan 2024 to Jun 2024 · Paris · FMCG beauty, €41B revenue',
    paragraphs: [
      'Rebuilt analytics reporting for the Top 20 markets into one standardised set of Power BI dashboards, writing the user stories and running the backlog to bring Kantar, Nielsen and B2B sources into AWS.',
      'Shipped an AI fuzzy-matching agent that allocates over 1,000 brands across four universes automatically, replacing a manual mapping workflow and giving the business near real-time portfolio visibility.',
      'Reconciled category definitions that disagreed across consolidators and more than 20 markets into a single comparable market-share view, which removed a blocker that kept resurfacing in executive revenue decisions.',
    ],
    tags: ['AI agents', 'Data products', 'AWS', 'Stakeholder management'],
  },
  {
    role: 'Business Analyst',
    company: 'Spinny',
    meta: 'Feb 2023 to Jun 2023 · Gurgaon · Series E, retail and e-commerce',
    paragraphs: [
      "Lifted visit-to-token conversion by 10% on Spinny's Hub mobile app, by running discovery with the showroom staff who used it daily and redesigning the flow that moved a buyer from visit to token payment.",
      "Cut delivery cancellations by 25%. I mined CRM leads data to reconstruct the token-to-delivery journey, worked out why customers were cancelling after they'd already paid a deposit, and handed the closure team a ranked list of cancellation drivers to run win-back against.",
    ],
    tags: ['Discovery', 'Funnel optimisation', 'SQL', 'Consumer'],
  },
  {
    role: 'Associate',
    company: 'ZoomRx',
    meta: 'May 2021 to Jan 2023 · Chennai · Strategy consulting, life sciences',
    paragraphs: [
      'Ran competitive benchmarking for global pharma clients including Janssen, GSK and Sanofi, measuring brand reach, share of voice, message effectiveness and sales-rep effectiveness against named rivals, then turning that read into promotional recommendations.',
      "Scoped go-to-market and launch studies for new drug entries, including cannibalisation analysis that separated whether projected share would come out of competitors or out of the client's own existing product.",
    ],
    tags: ['Strategy', 'Life sciences', 'Go-to-market'],
  },
];
---

<Base
  title="Experience · Madhurjya Bharadwaj"
  description="Where I've worked. Air Liquide, L'Oréal, Spinny, ZoomRx. Most recent first."
  accent="var(--cobalt)"
>
  <div class="container">
    <header class="page-head">
      <h1 class="title">Experience</h1>
      <p class="lead">Most recent first.</p>
    </header>

    <ol class="jobs">
      {
        jobs.map((job) => (
          <li class="job">
            <div class="job-when">
              <p class="label">{job.meta}</p>
            </div>
            <div class="job-what">
              <h2>
                {job.role} <span class="company">{job.company}</span>
              </h2>
              {job.paragraphs.map((text) => (
                <p>{text}</p>
              ))}
              <ul class="tags" aria-label="Themes">
                {job.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <section class="extra" aria-labelledby="education">
      <h2 id="education">Education</h2>
      <ul>
        <li>ESSEC Business School, Master in Management (Grande École), 2023 to 2026</li>
        <li>Vellore Institute of Technology, B.Tech, 2016 to 2020</li>
      </ul>
    </section>

    <section class="extra" aria-labelledby="certifications">
      <h2 id="certifications">Certifications</h2>
      <ul>
        <li>McKinsey Forward Program, 2026</li>
        <li>AI for Product Management, Mind the Product, 2025</li>
        <li>Strategy Consulting Virtual Experience, BCG, 2022</li>
      </ul>
    </section>

    <section class="extra" aria-labelledby="languages">
      <h2 id="languages">Languages</h2>
      <ul>
        <li>English (bilingual)</li>
        <li>Hindi (bilingual)</li>
        <li>French (intermediate)</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .container {
    padding-top: var(--nav-offset);
  }

  .jobs {
    border-top: 1px solid var(--hairline);
  }

  .job {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--hairline);
  }

  .job-when .label {
    max-width: 22ch;
  }

  .job-what h2 {
    font-size: var(--size-subhead);
    font-weight: 600;
    line-height: 1.3;
  }

  .company {
    display: block;
    font-weight: 400;
    color: var(--cobalt);
  }

  .job-what p {
    max-width: var(--measure);
    margin-top: 1.25rem;
  }

  .job-what h2 + p {
    margin-top: 1rem;
  }

  .job-what .tags {
    margin-top: 1.5rem;
  }

  .extra {
    max-width: var(--measure);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .extra h2 {
    font-size: var(--size-subhead);
    font-weight: 600;
    line-height: 1.3;
  }

  .extra ul {
    margin-top: 0.75rem;
  }

  .extra li + li {
    margin-top: 0.25rem;
  }

  @media (max-width: 720px) {
    .job {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .job-when .label {
      max-width: none;
    }
  }
</style>
