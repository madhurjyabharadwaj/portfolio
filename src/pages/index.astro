---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import avatar from '../assets/avatar.png';
import { WORK_TYPE_LABEL, byOrder } from '../lib/work';
import { SITE } from '../site';

const work = (await getCollection('work')).sort(byOrder);

const chips = [
  'Product Discovery',
  'User Research',
  'Roadmap & Prioritisation',
  'Data & Analytics',
  'AI & Data Products',
  'Prototyping',
  'Build & Run',
  'Stakeholder Alignment',
];

const menu = [
  { href: '/about', label: 'Who I am', sub: 'Engineer who moved into product', colour: 'butter' },
  { href: '/experience', label: "Where I've worked", sub: 'Enterprise, beauty, e-commerce, life sciences', colour: 'cobalt' },
  { href: '/work', label: 'Case studies and projects', sub: 'Problems, trade-offs, shipped outcomes', colour: 'raspberry' },
  { href: '/connect', label: "Let's talk", sub: 'Roles, collaboration, or just product', colour: 'ink' },
];

// Figures split into the number that counts up and the words after it.
// A figure with no leading number, such as a location, simply sits there.
const figure = (text: string) => {
  const match = /^(\d+)(.*)$/.exec(text);
  return match ? { n: match[1], rest: match[2] } : { n: '', rest: text };
};

const scorecard = [
  { figure: '4+ years', caption: 'in product and analytics' },
  { figure: '4 sectors', caption: 'life sciences, e-commerce, beauty, industrial' },
  { figure: '20+ markets', caption: 'worked across' },
  { figure: 'Paris & remote', caption: 'open to roles internationally' },
].map((item) => ({ ...item, ...figure(item.figure) }));

// The four jobs inside the product role.
const roles = [
  {
    role: 'Product Manager',
    word: 'Roadmaps',
    text: 'Prioritising, sequencing, and keeping a room full of opinions pointed the same way. Choosing what gets built next, then holding that line when someone senior wants to jump the queue.',
  },
  {
    role: 'Product Owner',
    word: 'Backlogs',
    text: 'PRDs, user stories, refinement. Turning a vague ask into something an engineering team can pick up on Monday morning without asking me three questions first.',
  },
  {
    role: 'Project Manager',
    word: 'Governance',
    text: 'Test plans, sign-offs, cutover checklists and the monthly numbers. The unglamorous rhythm that tells you where a programme actually is, rather than where the status slide says it is.',
  },
  {
    role: 'Business Analyst',
    word: 'Fieldwork',
    text: 'Interviews, shadowing, and funnel data read alongside them. Where somebody gets stuck says far more than what they tell you they want.',
  },
];

// Grouped from the skills section of the CV, plus the tools the projects on
// this site were actually built with.
const toolkit = [
  {
    group: 'Product',
    items: [
      'Discovery',
      'PRDs and user stories',
      'Roadmap and backlog',
      'Prioritisation',
      'Experimentation and A/B testing',
      'KPI and OKR design',
      'UAT',
      'Rollout and change management',
      'Build and run',
      'Stakeholder management',
    ],
  },
  {
    group: 'Data and analytics',
    items: ['SQL', 'Python', 'Power BI', 'Tableau', 'Looker', 'Excel'],
  },
  {
    group: 'AI',
    items: ['LLM-powered MVPs', 'Prompt engineering', 'AI agent deployment', 'Fuzzy matching'],
  },
  {
    group: 'Platforms and tools',
    items: ['Jira', 'ServiceNow', 'Figma', 'AWS', 'GCP', 'Git'],
  },
  {
    group: 'Building',
    items: ['JavaScript', 'Three.js', 'Web Audio', 'Offline-first PWAs', 'Lovable', 'Replit', 'Glide'],
  },
];

const principles = [
  {
    title: 'Name the problem first',
    text: "A feature request is somebody's guess at a solution. I work backwards from it until the problem fits in one sentence, and only then talk about what to build.",
  },
  {
    title: 'Buy certainty cheaply',
    text: 'A prototype, a pilot and four honest conversations cost less than a quarter of engineering time. Better to break an idea while it still takes a week to fix.',
  },
  {
    title: 'Make the trade-off visible',
    text: "Every real decision gives something up. I'd rather write down what we're sacrificing and defend it than ship a compromise nobody actually chose.",
  },
  {
    title: 'Judge it by what moved',
    text: 'Shipping on time is where the question starts. What counts is whether people use it, whether it survives production, and whether a number anyone cares about changed.',
  },
];
---

<Base
  title="Madhurjya Bharadwaj, Product Manager"
  description="I'm a Product Manager who takes products from the first PRD to running in production, and writes the code for my own on the side. Four sectors and twenty-plus markets have taught me one thing that carries across all of them: the real problem usually sits with whoever has to use the product, not whoever asked for it. That's where I start."
>
  <section class="hero container" aria-labelledby="hero-title">
    <p class="label-pill hero-pill"><span class="dot" aria-hidden="true"></span><span class="eyebrow">Product Manager</span></p>
    <h1 id="hero-title" class="display hero-title">
      <span class="line"><span class="line-in">Right problem.</span></span>
      <span class="line"><span class="line-in">Real product.</span></span>
      <span class="line"><span class="line-in accent">Shipped.</span></span>
    </h1>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="lead">
          I'm a Product Manager who takes products from the first PRD to running in production, and writes
          the code for my own on the side. Four sectors and twenty-plus markets have taught me one thing that
          carries across all of them: the real problem usually sits with whoever has to use the product, not
          whoever asked for it. That's where I start.
        </p>
        <div class="hero-chips">
          <p class="eyebrow">Working across the product lifecycle</p>
          <ul class="tags" aria-label="Areas of work">
            {chips.map((chip) => <li>{chip}</li>)}
          </ul>
        </div>
        <div class="hero-actions">
          <a class="button primary" href={SITE.cv} download>Resume ↓</a>
          <a class="button" href="/connect">Let's connect →</a>
        </div>
      </div>
      <div class="hero-avatar-wrap">
        <div class="hero-avatar">
          <Image
            src={avatar}
            alt="Illustration of Madhurjya smiling at a laptop, in glasses, a dark jacket and a white t-shirt."
            widths={[420, 640, 900]}
            sizes="(min-width: 900px) 400px, 80vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <nav class="menu container" aria-label="Sections">
    <ul data-reveal-group>
      {
        menu.map((item) => (
          <li>
            <a href={item.href} class="menu-card">
              <span class={`menu-mark ${item.colour}`} aria-hidden="true" />
              <span class="menu-label">{item.label}</span>
              <span class="menu-sub">{item.sub}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section class="scorecard container" aria-label="At a glance">
    <ul data-reveal-group>
      {
        scorecard.map((item) => (
          <li>
            {/* Kept on one line: any whitespace here would appear between the number and its unit. */}
            <strong>{item.n && <span class="num" data-count={item.n}>{item.n}</span>}{item.rest}</strong>
            <span class="label">{item.caption}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="roles" class="section container" aria-labelledby="roles-title">
    <div class="section-head" data-reveal>
      <h2 id="roles-title" class="title">The roles I cover</h2>
      <p class="lead">
        Most teams split these titles between different people. I have carried all four in the same week,
        which is the argument for hiring someone who has done each of them rather than one of them neatly.
      </p>
    </div>
    <ul class="roles" data-reveal-group>
      {
        roles.map((item) => (
          <li>
            <span class="role-label">{item.role}</span>
            <h3 class="role-word">{item.word}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="approach" class="section container philosophy" aria-labelledby="philosophy-title">
    <div class="philosophy-head" data-reveal>
      <h2 id="philosophy-title" class="title">How I make the call</h2>
      <p class="lead">
        Four habits that decide what I do when the evidence is thin and somebody wants an answer today.
      </p>
    </div>
    <ol class="principles" data-reveal-group>
      {
        principles.map((item) => (
          <li>
            <span class="principle-mark" aria-hidden="true" />
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="toolkit" class="section container" aria-labelledby="toolkit-title">
    <div class="section-head" data-reveal>
      <h2 id="toolkit-title" class="title">Capabilities and toolkit</h2>
      <p class="lead">What I actually use, grouped by the job it does.</p>
    </div>
    <dl class="stack" data-reveal-group>
      {
        toolkit.map((row) => (
          <div class="stack-row">
            <dt>{row.group}</dt>
            <dd>
              <ul class="tags">
                {row.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="work" class="section container" aria-labelledby="work-title">
    <div class="section-head" data-reveal>
      <h2 id="work-title" class="title">Work</h2>
      <p class="lead">
        Case studies and projects. Each one goes into how the problem was framed, the trade-offs, the
        architecture where there is one, and what actually changed, across AI, B2B, data and consumer
        products. Every write-up includes the part I'd do differently.
      </p>
    </div>
    <ul class="cards">
      {
        work.map((entry, i) => (
          <li data-reveal>
            <WorkCard
              number={String(entry.data.order).padStart(2, '0')}
              type={entry.data.type}
              typeLabel={WORK_TYPE_LABEL[entry.data.type]}
              category={entry.data.category}
              year={entry.data.year}
              title={entry.data.title}
              subtitle={entry.data.subtitle}
              problem={entry.data.problem}
              role={entry.data.role}
              outcome={entry.data.outcome}
              tags={entry.data.tags}
              cover={entry.data.cover}
              coverAlt={entry.data.coverAlt}
              video={entry.data.video}
              links={entry.data.links}
              name={entry.data.name}
              href={`/work/${entry.id}`}
              cta="Read the full case study →"
              flip={i % 2 === 1}
            />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* Hero: the headline owns the full width; copy and portrait sit beneath it. */
  .hero {
    padding-top: calc(var(--nav-offset) + clamp(1.5rem, 4vw, 3.5rem));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-title {
    margin-top: 1.5rem;
  }

  .hero-title .line {
    display: block;
  }

  .hero-title .line-in {
    display: inline-block;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .hero-copy > * + * {
    margin-top: 1.5rem;
  }

  .hero-copy .lead {
    color: var(--ink);
  }

  .hero-chips .eyebrow {
    margin-bottom: 0.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .hero-avatar-wrap {
    justify-self: end;
    width: 100%;
    max-width: 400px;
  }

  .hero-avatar {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    border-radius: 999px 999px var(--radius-menu) var(--radius-menu);
    background: var(--butter);
  }

  /* :global because the <Image> component's img is not scoped to this file. */
  .hero-avatar :global(img) {
    width: 130%;
    max-width: none;
    height: auto;
    margin-bottom: -2%;
  }

  @media (max-width: 720px) {
    .hero-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero-avatar-wrap {
      justify-self: start;
      max-width: 300px;
    }
  }

  /* Card menu: white cards on the frost ground, one small mark each in its
     section colour. The same colour reappears as the rule under that page's title. */
  .menu ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .menu-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 13rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-menu);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
  }

  .menu-mark {
    width: 0.875rem;
    height: 0.875rem;
    margin-bottom: auto;
    border-radius: 4px;
  }

  .menu-mark.butter {
    background: var(--butter);
  }

  .menu-mark.cobalt {
    background: var(--cobalt);
  }

  .menu-mark.raspberry {
    background: var(--raspberry);
  }

  .menu-mark.ink {
    background: var(--ink);
  }

  .menu-label {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: var(--size-tile);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .menu-sub {
    font-size: var(--size-label);
    font-weight: 500;
    line-height: 1.4;
    color: var(--muted);
  }

  .menu-card:hover .menu-label {
    color: var(--cobalt);
  }

  @media (max-width: 900px) {
    .menu ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .menu ul {
      grid-template-columns: 1fr;
    }

    .menu-card {
      min-height: 0;
    }

    .menu-label {
      margin-top: 1.25rem;
    }
  }

  /* Scorecard strip: four figures on one line. The figures size themselves
     from the strip's own width, so they fit whatever the viewport. */
  .scorecard {
    margin-top: var(--section-gap);
  }

  .scorecard ul {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .scorecard strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.6cqi, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--ink);
  }

  .scorecard .num {
    font-variant-numeric: tabular-nums;
  }

  .scorecard .label {
    display: block;
    max-width: 24ch;
    margin-top: 0.6rem;
  }

  @media (max-width: 900px) {
    .scorecard ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }

    .scorecard strong {
      font-size: clamp(1.5rem, 6.5cqi, 2.5rem);
    }
  }

  /* Consecutive sections share one gap rather than stacking two. */
  .section + .section {
    padding-top: 0;
  }

  /* The four jobs: one panel divided by hairlines, so it reads as a single
     object rather than four more cards. */
  .roles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-menu);
    background: var(--white);
    overflow: hidden;
  }

  .roles li {
    padding: clamp(1.5rem, 2.5vw, 2rem);
  }

  .roles li + li {
    border-left: 1px solid var(--hairline);
  }

  .role-label {
    display: block;
    font-size: var(--size-label);
    font-weight: 500;
    color: var(--muted);
  }

  .role-word {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--size-word);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .roles p {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--slate);
  }

  @media (max-width: 960px) {
    .roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .roles li:nth-child(odd) {
      border-left: 0;
    }

    .roles li:nth-child(n + 3) {
      border-top: 1px solid var(--hairline);
    }
  }

  @media (max-width: 560px) {
    .roles {
      grid-template-columns: 1fr;
    }

    .roles li + li {
      border-left: 0;
      border-top: 1px solid var(--hairline);
    }
  }

  /* Philosophy: the heading holds its place while the principles scroll past. */
  .philosophy {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .philosophy-head {
    position: sticky;
    top: calc(var(--nav-offset) + 2rem);
  }

  .philosophy-head .lead {
    margin-top: 1rem;
  }

  .principles li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: clamp(1.5rem, 2.5vw, 2rem);
    border-top: 1px solid var(--hairline);
  }

  .principles li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .principle-mark {
    width: 0.625rem;
    height: 0.625rem;
    margin-top: 0.55rem;
    border: 2px solid var(--cobalt);
    border-radius: 2px;
    transform: rotate(45deg);
  }



  .principles h3 {
    font-size: var(--size-subhead);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .principles p {
    margin-top: 0.5rem;
    max-width: 52ch;
  }

  @media (max-width: 860px) {
    .philosophy {
      grid-template-columns: 1fr;
    }

    .philosophy-head {
      position: static;
    }

    .principles li {
      gap: 1rem;
    }
  }

  /* Capabilities: label on the left, chips on the right, one row per group. */
  .stack-row {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 2fr);
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .stack-row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .stack-row dt {
    font-size: var(--size-label);
    font-weight: 600;
    color: var(--ink);
  }

  .stack-row dd {
    margin: 0;
  }

  @media (max-width: 720px) {
    .stack-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  /* Work cards */
  .cards {
    display: grid;
    gap: 1.5rem;
  }
</style>
