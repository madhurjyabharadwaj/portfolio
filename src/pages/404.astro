---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found · Madhurjya Bharadwaj"
  description="There is nothing at this address."
  accent="var(--cobalt)"
  noindex
>
  <div class="container">
    <header class="page-head">
      <h1 class="title">Page not found</h1>
      <p class="lead">There’s nothing at this address. The link may have a typo, or the page may have moved.</p>
    </header>
    <p class="not-found-actions">
      <a class="button primary" href="/">Go to the home page</a>
      <a class="button" href="/work">See the work</a>
    </p>
  </div>
</Base>

<style>
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 2rem var(--section-gap);
  }
</style>
