---
import Base from '../layouts/Base.astro';
import { SITE, isFormConfigured } from '../site';
---

<Base
  title="Let’s talk · Madhurjya Bharadwaj"
  description="If you want to talk product, that’s enough of a reason. I’m happy to walk through any of the work on this site, compare notes on getting into product from engineering or analytics, look at something you’re building, or hear about a role."
  accent="var(--ink)"
>
  <div class="container">
    <header class="page-head" data-reveal>
      <h1 class="title">Let’s talk</h1>
      <p class="lead">
        If you want to talk product, that’s enough of a reason. I’m happy to walk through any of the work on
        this site, compare notes on getting into product from engineering or analytics, look at something
        you’re building, or hear about a role. Pick whichever applies.
      </p>
    </header>

    <div class="connect">
      <ul class="ways" aria-label="Ways to reach me" data-reveal-group>
        <li><a href={`mailto:${SITE.email}`}>Email</a><span class="label">{SITE.email}</span></li>
        <li><a href={SITE.linkedin} rel="me">LinkedIn</a><span class="label">madhurjya-bharadwaj</span></li>
        <li><a href={SITE.github} rel="me">GitHub</a><span class="label">madhurjyabharadwaj</span></li>
        <li><a href={SITE.cv} download>Resume</a><span class="label">PDF</span></li>
      </ul>

      {
        isFormConfigured ? (
          <form class="form" data-reveal action={SITE.formEndpoint} method="POST">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="6" required />
            </div>
            {/* Sets the subject line of the email Formspree sends. */}
            <input type="hidden" name="_subject" value="Message from the portfolio site" />
            {/* Formspree honeypot: bots fill it, people never see it. */}
            <input
              type="text"
              name="_gotcha"
              tabindex="-1"
              autocomplete="off"
              class="sr-only"
              aria-hidden="true"
            />
            <button class="button primary" type="submit">
              Send
            </button>
            <p class="form-status" role="status" aria-live="polite" tabindex="-1" hidden />
          </form>
        ) : (
          /* No form until `formEndpoint` in src/site.ts is real. Better a
             working mailto than a box that swallows what someone types. */
          <p class="form-fallback" data-reveal>
            The form isn’t connected yet. Email me directly at{' '}
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
          </p>
        )
      }
    </div>
  </div>
</Base>

<script>
  // Submit through fetch so the sender stays on the page instead of being
  // handed to a Formspree-branded thank-you screen. Without JavaScript the
  // form still posts normally, which also works.
  const form = document.querySelector<HTMLFormElement>('.form');
  const status = document.querySelector<HTMLParagraphElement>('.form-status');

  if (form && status) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    const show = (message: string, ok: boolean) => {
      status.textContent = message;
      status.classList.toggle('is-error', !ok);
      status.hidden = false;
      status.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!button) return;

      button.disabled = true;
      button.textContent = 'Sending';
      status.hidden = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          show('Thanks. Your message is on its way.', true);
          button.textContent = 'Sent';
          return;
        }

        // Formspree returns the reason in an errors array when it can.
        const data = await response.json().catch(() => null);
        const reason = data?.errors?.map((e: { message: string }) => e.message).join(', ');
        show(reason || 'That did not send. Please email me instead.', false);
      } catch {
        show('That did not send. Please email me instead.', false);
      }

      button.disabled = false;
      button.textContent = 'Send';
    });
  }
</script>

<style>
  .container {
    padding-top: var(--nav-offset);
  }

  .connect {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .ways li {
    display: flex;
    flex-direction: column;
    padding-block: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .ways li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .ways a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .ways a:hover {
    color: var(--cobalt);
    text-decoration: underline;
  }

  .form {
    display: grid;
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-size: var(--size-label);
    font-weight: 500;
    color: var(--ink);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1.5px solid var(--hairline-strong);
    border-radius: var(--radius-button);
    background: var(--white);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--ink);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .form .button {
    justify-self: start;
  }

  .form .button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .form-status {
    margin: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--butter);
    color: var(--ink);
  }

  .form-status.is-error {
    border-left-color: var(--raspberry);
    color: var(--raspberry);
  }

  .form-fallback {
    padding-left: 1rem;
    border-left: 3px solid var(--butter);
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .connect {
      grid-template-columns: 1fr;
    }
  }
</style>
