---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { WORK_TYPE_LABEL } from '../../lib/work';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, subtitle, name, type, category, year, links, downloads, cover, coverAlt, video } = entry.data;
const { Content } = await render(entry);

// The poster is optimised at build time; the video itself is only fetched
// once someone presses play.
const poster = video ? await getImage({ src: video.poster, width: 540, format: 'webp' }) : null;
---

<Base
  title={`${name} · Madhurjya Bharadwaj`}
  description={`${title} ${subtitle}.`}
  ogType="article"
  accent="var(--raspberry)"
>
  <article class="container">
    <header class="page-head" data-reveal>
      <p class="meta">
        <span class="pill" data-type={type}>{WORK_TYPE_LABEL[type]}</span>
        <span class="label">{category}</span>
        <span class="label">{year}</span>
      </p>
      <h1 class="title">{title}</h1>
      <p class="subtitle">{subtitle}</p>
    </header>

    <div class:list={['media', { 'with-video': !!video }]} data-reveal>
      <figure class="cover">
        <Image
          src={cover}
          alt={coverAlt}
          widths={[720, 1080, 1440]}
          sizes="(min-width: 1200px) 760px, 100vw"
          loading="eager"
        />
      </figure>
      {
        video && poster && (
          <figure class="clip">
            <video controls preload="none" playsinline poster={poster.src} aria-label={video.alt}>
              <source src={video.src} type="video/mp4" />
              Your browser cannot play this video.
            </video>
            <figcaption>Launch video, {video.seconds} seconds, with sound</figcaption>
          </figure>
        )
      }
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      (downloads.length > 0 || links.length > 0) && (
        <div class="actions">
          {downloads.map((file, i) => (
            <a class:list={['button', { primary: i === 0 }]} href={file.href} download>
              {file.label}
            </a>
          ))}
          {links.map((link) => (
            <a class="button" href={link.href}>
              {link.label}
            </a>
          ))}
        </div>
      )
    }

    <p class="back">
      <a href="/work">All work</a>
    </p>
  </article>
</Base>

<style>
  .container {
    padding-top: var(--nav-offset);
  }

  .page-head .title {
    max-width: 18ch; /* ch of the title's own size, so roughly two to three lines */
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .subtitle {
    max-width: var(--measure);
    margin-top: 1.25rem;
    font-size: var(--size-lead);
    line-height: 1.4;
    color: var(--muted);
  }

  /* Cover and launch video sit side by side, sized so their heights match. */
  .media {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .media.with-video {
    grid-template-columns: minmax(0, 2.37fr) minmax(0, 1fr);
    align-items: start;
  }

  .cover,
  .clip {
    margin: 0;
  }

  .cover {
    overflow: hidden;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-menu);
    background: var(--white);
  }

  .cover :global(img) {
    width: 100%;
    height: auto;
  }

  .clip video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-menu);
    background: var(--ink);
    box-shadow: 0 18px 40px -22px rgba(20, 27, 61, 0.5);
  }

  .clip figcaption {
    margin-top: 0.6rem;
    font-size: var(--size-label);
    font-weight: 500;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .media.with-video {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .clip {
      width: min(100%, 320px);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: var(--measure);
    margin-top: 3rem;
  }

  .back {
    max-width: var(--measure);
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
    font-weight: 500;
  }
</style>
