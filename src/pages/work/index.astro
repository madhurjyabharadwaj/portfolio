---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { WORK_TYPE_LABEL, byOrder } from '../../lib/work';

const work = (await getCollection('work')).sort(byOrder);
const alsoBuilt = (await getCollection('alsoBuilt')).sort(byOrder);
---

<Base
  title="Work · Madhurjya Bharadwaj"
  description="Case studies and projects. Each one goes into how the problem was framed, the trade-offs, the architecture where there is one, and what actually changed, across AI, B2B, data and consumer products."
  accent="var(--raspberry)"
>
  <div class="container">
    <header class="page-head" data-reveal>
      <h1 class="title">Work</h1>
      <p class="lead">
        Case studies and projects. Each one goes into how the problem was framed, the trade-offs, the
        architecture where there is one, and what actually changed, across AI, B2B, data and consumer
        products. Every write-up includes the part I'd do differently.
      </p>
    </header>

    <ul class="cards">
      {
        work.map((entry, i) => (
          <li data-reveal>
            <WorkCard
              headingLevel="h2"
              number={String(entry.data.order).padStart(2, '0')}
              type={entry.data.type}
              typeLabel={WORK_TYPE_LABEL[entry.data.type]}
              category={entry.data.category}
              year={entry.data.year}
              title={entry.data.title}
              subtitle={entry.data.subtitle}
              problem={entry.data.problem}
              role={entry.data.role}
              outcome={entry.data.outcome}
              tags={entry.data.tags}
              cover={entry.data.cover}
              coverAlt={entry.data.coverAlt}
              video={entry.data.video}
              href={`/work/${entry.id}`}
              cta="Read the full case study →"
              flip={i % 2 === 1}
            />
          </li>
        ))
      }
    </ul>

    <section class="also section" aria-labelledby="also-title">
      <div class="section-head" data-reveal>
        <h2 id="also-title" class="title">Also built</h2>
      </div>
      <ul class="cards">
        {
          alsoBuilt.map((entry) => {
            const repo = entry.data.links.find((l) => l.label === 'Repo') ?? entry.data.links[0];
            return (
              <li data-reveal>
                <WorkCard
                  headingLevel="h3"
                  title={entry.data.name}
                  subtitle={entry.data.subtitle}
                  problem={entry.data.problem}
                  role={entry.data.role}
                  outcome={entry.data.outcome}
                  tags={entry.data.tags}
                  href={repo.href}
                  cta={`${repo.label} →`}
                  external
                />
              </li>
            );
          })
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .container {
    padding-top: var(--nav-offset);
  }

  .cards {
    display: grid;
    gap: 1.5rem;
  }

  .also {
    padding-bottom: 0;
  }
</style>
