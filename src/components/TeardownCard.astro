---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

/**
 * One teardown, used on /teardowns and at the foot of /work. Like the work
 * card, the title link is stretched over the whole card.
 */
interface Props {
  entry: CollectionEntry<'teardowns'>;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel = 'h2' } = Astro.props;
const { title, summary, date, readTime, tags, cover, coverAlt } = entry.data;
const Heading = headingLevel;
---

<article class="teardown-card">
  <div class="cover">
    <Image src={cover} alt={coverAlt} widths={[560, 840, 1120]} sizes="(min-width: 900px) 480px, 100vw" />
  </div>
  <div class="body">
    <p class="meta">{date} · {readTime}</p>
    <Heading class="title">
      <a class="link" href={`/teardowns/${entry.id}`}>{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
    <ul class="tags" aria-label="Tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <span class="cta" aria-hidden="true">Read the teardown</span>
  </div>
</article>

<style>
  .teardown-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-fluid-s);
    align-items: center;
    padding: var(--space-fluid-s);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-l);
    background: var(--white);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .teardown-card:hover {
    border-color: var(--ink);
  }

  .cover {
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-m);
    aspect-ratio: 40 / 21;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    min-width: 0;
  }

  .meta {
    font-size: var(--size-label);
    font-weight: 500;
    color: var(--muted);
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--size-tile);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 32;
  }

  .link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .teardown-card:hover .link {
    color: var(--cobalt);
  }

  .summary {
    color: var(--slate);
  }

  .cta {
    margin-top: var(--space-1);
    padding-bottom: 2px;
    border-bottom: 2px solid var(--ink);
    color: var(--ink);
    font-weight: 600;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .teardown-card:hover .cta {
    color: var(--cobalt);
    border-color: var(--cobalt);
  }

  @media (max-width: 860px) {
    .teardown-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
