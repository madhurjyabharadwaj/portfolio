---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The rich work card used on the home page and /work. The whole card is one
 * link: the title carries the href and a pseudo-element stretches it over the
 * card, so the accessible name stays short.
 */
interface Props {
  /** Poster and length of a launch video, when the piece has one. */
  video?: { poster: ImageMetadata; seconds: number };
  title: string;
  subtitle: string;
  problem: string;
  role: string;
  outcome: string;
  tags: string[];
  href: string;
  /** Text of the card's own call to action. Omitted when the links carry it. */
  cta?: string;
  /** Live site, repo, anything else worth reaching without opening the page. */
  links?: { label: string; href: string }[];
  /** Used to tell one card's links from another's for screen readers. */
  name?: string;
  number?: string;
  type?: 'case-study' | 'project';
  typeLabel?: string;
  category?: string;
  year?: number;
  cover?: ImageMetadata;
  coverAlt?: string;
  /** Put the cover on the right instead of the left. */
  flip?: boolean;
  headingLevel?: 'h2' | 'h3';
  external?: boolean;
}

const {
  video,
  title,
  subtitle,
  problem,
  role,
  outcome,
  tags,
  href,
  cta,
  links = [],
  name,
  number,
  type,
  typeLabel,
  category,
  year,
  cover,
  coverAlt = '',
  flip = false,
  headingLevel = 'h3',
  external = false,
} = Astro.props;
const Heading = headingLevel;
---

<article class:list={['work-card', { flip, 'no-cover': !cover }]} data-type={type}>
  {
    cover && (
      <div class="card-cover">
        <Image src={cover} alt={coverAlt} widths={[560, 840, 1120]} sizes="(min-width: 900px) 520px, 100vw" />
        {video && (
          <span
            class="cover-clip"
            style={`--clip-aspect: ${video.poster.width / video.poster.height}; --clip-width: ${
              video.poster.width < video.poster.height ? '26%' : '40%'
            }`}
          >
            <Image src={video.poster} alt="" widths={[180, 360]} sizes="120px" />
            <span class="cover-clip-label">
              <svg viewBox="0 0 12 12" width="9" height="9" aria-hidden="true">
                <path d="M2 1.2 10.2 6 2 10.8Z" fill="currentColor" />
              </svg>
              Launch video
            </span>
          </span>
        )}
      </div>
    )
  }
  <div class="card-body">
    <p class="card-meta">
      {number && <span class="card-number">{number}</span>}
      <span class="card-cat">
        {type && typeLabel && <span class="pill" data-type={type}>{typeLabel}</span>}
        {category && <span>{category}</span>}
      </span>
      {year && <span class="card-year">{year}</span>}
    </p>
    <Heading class="card-title">
      <a class="card-link" href={href} rel={external ? 'noopener' : undefined}>
        {title}
      </a>
    </Heading>
    <p class="card-subtitle">{subtitle}</p>
    <blockquote class="card-problem">
      <span class="eyebrow">Problem statement</span>
      <p>{problem}</p>
    </blockquote>
    <dl class="card-facts">
      <div>
        <dt>My role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>Key outcome</dt>
        <dd>{outcome}</dd>
      </div>
    </dl>
    <ul class="tags" aria-label="Tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="card-actions">
      {cta && <span class="card-cta" aria-hidden="true">{cta}</span>}
      {links.length > 0 && (
        <ul class="card-links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel="noopener" aria-label={name ? `${link.label}: ${name}` : undefined}>
                <svg viewBox="0 0 14 14" width="11" height="11" aria-hidden="true">
                  <path
                    d="M5.5 2.5H2.5v9h9v-3M8.5 2.5h3v3M11.5 2.5 6 8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-menu);
    background: var(--white);
  }

  .work-card.flip .card-cover {
    order: 2;
  }

  .work-card.no-cover {
    grid-template-columns: 1fr;
  }

  .card-cover {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-tile);
    border: 1px solid var(--hairline);
    background: var(--frost);
    aspect-ratio: 4 / 3;
  }

  .card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    /* Oversize slightly so the scroll-linked drift never shows an edge. */
    transform: scale(1.1);
  }

  /* Scroll-linked drift: the cover slides a few percent as the card crosses
     the viewport. Only in browsers with scroll-driven animations. */
  @supports (animation-timeline: view()) {
    .card-cover :global(img) {
      animation: cover-drift linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }

    @keyframes cover-drift {
      from {
        transform: scale(1.1) translateY(4%);
      }
      to {
        transform: scale(1.1) translateY(-4%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-cover :global(img) {
      animation: none;
      transform: none;
    }
  }

  /* The launch video announces itself on the cover; the whole card still
     links to the page, where the video actually plays. */
  .cover-clip {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: var(--clip-width, 26%);
    max-width: 190px;
    aspect-ratio: var(--clip-aspect, 9 / 16);
    overflow: hidden;
    border-radius: 12px;
    box-shadow:
      0 0 0 3px var(--white),
      0 10px 24px -10px rgba(20, 27, 61, 0.55);
  }

  .cover-clip :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-clip-label {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.35rem 0.25rem;
    background: rgba(20, 27, 61, 0.82);
    color: var(--white);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
  }

  @media (max-width: 420px) {
    .cover-clip-label {
      font-size: 0.625rem;
    }
  }

  .card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    min-width: 0;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    font-size: var(--size-label);
    font-weight: 500;
    color: var(--muted);
  }

  .card-number {
    font-weight: 600;
    color: var(--cobalt);
  }

  .card-cat {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .card-year {
    margin-left: auto;
    color: var(--ink);
    font-weight: 600;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--size-tile);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 32;
    text-wrap: balance;
  }

  .card-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* Stretch the title link over the whole card. The z-index lifts it above
     positioned children such as the problem block, while the actions row
     shares the same level and wins on document order. */
  .card-link::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: inherit;
  }

  .work-card:hover .card-link {
    color: var(--cobalt);
  }

  .card-subtitle {
    margin-top: -0.4rem;
    color: var(--muted);
    font-weight: 500;
  }

  /* The problem statement: a tinted field with the opening quote set large in
     the display face, so the type carries the emphasis rather than a bar. */
  .card-problem {
    position: relative;
    width: 100%;
    padding: 0.9rem 1.1rem 1rem 3.1rem;
    border-radius: 12px;
    background: var(--cobalt-tint);
  }

  .card-problem::before {
    content: '\201C';
    position: absolute;
    top: 0.55rem;
    left: 0.9rem;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    color: var(--cobalt);
  }

  .card-problem .eyebrow {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--cobalt);
  }

  .card-problem p {
    color: var(--ink);
    font-weight: 500;
    line-height: 1.5;
  }

  .card-facts {
    display: grid;
    gap: 0.6rem;
  }

  .card-facts dt {
    display: inline;
    font-weight: 600;
    color: var(--ink);
  }

  .card-facts dt::after {
    content: ': ';
  }

  .card-facts dd {
    display: inline;
    margin: 0;
    color: var(--slate);
  }

  /* Sits above the stretched title link so the Live and Repo links stay
     clickable. The row itself takes no pointer events: it spans the full width
     of the body, and anything in it that is not a real link -- the call to
     action, the gaps -- would otherwise sit on top of the card link and
     swallow the click instead of opening the write-up. */
  .card-actions {
    position: relative;
    z-index: 1;
    pointer-events: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.25rem;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .card-links a {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font-size: var(--size-label);
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .card-links a:hover {
    border-color: var(--cobalt);
    color: var(--cobalt);
  }

  .card-cta {
    padding-bottom: 2px;
    border-bottom: 2px solid var(--ink);
    color: var(--ink);
    font-weight: 600;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .work-card:hover .card-cta {
    color: var(--cobalt);
    border-color: var(--cobalt);
  }

  @media (max-width: 860px) {
    .work-card {
      grid-template-columns: 1fr;
    }

    .work-card.flip .card-cover {
      order: 0;
    }
  }
</style>
