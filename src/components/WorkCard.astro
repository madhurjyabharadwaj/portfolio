---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The rich work card used on the home page and /work. The whole card is one
 * link: the title carries the href and a pseudo-element stretches it over the
 * card, so the accessible name stays short.
 */
interface Props {
  /** Poster and length of a launch video, when the piece has one. */
  video?: { poster: ImageMetadata; seconds: number };
  title: string;
  subtitle: string;
  problem: string;
  role: string;
  outcome: string;
  tags: string[];
  href: string;
  /** Text of the card’s own call to action. Omitted when the links carry it. */
  cta?: string;
  /** Live site, repo, anything else worth reaching without opening the page. */
  links?: { label: string; href: string }[];
  /** Used to tell one card’s links from another’s for screen readers. */
  name?: string;
  number?: string;
  type?: 'case-study' | 'project';
  typeLabel?: string;
  category?: string;
  year?: number;
  cover?: ImageMetadata;
  coverAlt?: string;
  headingLevel?: 'h2' | 'h3';
  external?: boolean;
}

const {
  video,
  title,
  subtitle,
  problem,
  role,
  outcome,
  tags,
  href,
  cta,
  links = [],
  name,
  number,
  type,
  typeLabel,
  category,
  year,
  cover,
  coverAlt = '',
  headingLevel = 'h3',
  external = false,
} = Astro.props;
const Heading = headingLevel;
---

<article class:list={['work-card', { 'no-cover': !cover }]} data-type={type}>
  {
    cover && (
      <div class="card-cover">
        <Image src={cover} alt={coverAlt} widths={[560, 840, 1120]} sizes="(min-width: 900px) 520px, 100vw" />
        {video && (
          <span
            class="cover-clip"
            style={`--clip-aspect: ${video.poster.width / video.poster.height}; --clip-width: ${
              video.poster.width < video.poster.height ? '26%' : '40%'
            }`}
          >
            <Image src={video.poster} alt="" widths={[180, 360]} sizes="120px" />
            <span class="cover-clip-label">
              <svg viewBox="0 0 12 12" width="9" height="9" aria-hidden="true">
                <path d="M2 1.2 10.2 6 2 10.8Z" fill="currentColor" />
              </svg>
              Launch video
            </span>
          </span>
        )}
      </div>
    )
  }
  <div class="card-head">
    <p class="card-meta">
      {number && <span class="card-number">{number}</span>}
      <span class="card-cat">
        {type && typeLabel && <span class="pill" data-type={type}>{typeLabel}</span>}
        {category && <span>{category}</span>}
      </span>
      {year && <span class="card-year">{year}</span>}
    </p>
    <Heading class="card-title">
      <a class="card-link" href={href} rel={external ? 'noopener' : undefined}>
        {title}
      </a>
    </Heading>
    <p class="card-subtitle">{subtitle}</p>
    <blockquote class="card-problem">
      <p><strong>Problem statement:</strong> {problem}</p>
    </blockquote>
  </div>
  <div class="card-detail">
    <dl class="card-facts">
      <div>
        <dt>My role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>Key outcome</dt>
        <dd>{outcome}</dd>
      </div>
    </dl>
    <ul class="tags" aria-label="Tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="card-actions">
      {cta && <span class="card-cta" aria-hidden="true">{cta}</span>}
      {links.length > 0 && (
        <ul class="card-links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel="noopener" aria-label={name ? `${link.label}: ${name}` : undefined}>
                <svg viewBox="0 0 14 14" width="11" height="11" aria-hidden="true">
                  <path
                    d="M5.5 2.5H2.5v9h9v-3M8.5 2.5h3v3M11.5 2.5 6 8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</article>

<style>
  /* Top row: cover beside the title and problem. Second row, full width:
     role, outcome, tags and links. Every card has the cover on the same side
     so the titles line up down the page. */
  .work-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    grid-template-areas:
      'cover head'
      'detail detail';
    gap: var(--space-fluid-s);
    align-items: start;
    padding: var(--space-fluid-s);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-l);
    background: var(--white);
  }

  .work-card.no-cover {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'detail';
    gap: var(--space-4);
  }

  .card-cover {
    grid-area: cover;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-m);
    border: 1px solid var(--hairline);
    background: var(--frost);
    aspect-ratio: 4 / 3;
  }

  .card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    /* Oversize slightly so the scroll-linked drift never shows an edge. */
    transform: scale(1.1);
  }

  /* Scroll-linked drift: the cover slides a few percent as the card crosses
     the viewport. Only in browsers with scroll-driven animations. */
  @supports (animation-timeline: view()) {
    .card-cover :global(img) {
      animation: cover-drift linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }

    @keyframes cover-drift {
      from {
        transform: scale(1.1) translateY(4%);
      }
      to {
        transform: scale(1.1) translateY(-4%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-cover :global(img) {
      animation: none;
      transform: none;
    }
  }

  /* The launch video announces itself on the cover; the whole card still
     links to the page, where the video actually plays. */
  .cover-clip {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: var(--clip-width, 26%);
    max-width: 190px;
    aspect-ratio: var(--clip-aspect, 9 / 16);
    overflow: hidden;
    border-radius: var(--radius-m);
    box-shadow:
      0 0 0 3px var(--white),
      var(--shadow-clip);
  }

  .cover-clip :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-clip-label {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-1);
    background: var(--scrim);
    color: var(--white);
    font-size: var(--size-micro);
    font-weight: 600;
    line-height: 1;
  }

  .card-head,
  .card-detail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    min-width: 0;
  }

  .card-head {
    grid-area: head;
  }

  .card-detail {
    grid-area: detail;
  }

  .work-card:not(.no-cover) .card-detail {
    padding-top: var(--space-fluid-s);
    border-top: 1px solid var(--hairline);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    font-size: var(--size-label);
    font-weight: 500;
    color: var(--muted);
  }

  .card-number {
    font-weight: 600;
    color: var(--cobalt);
  }

  .card-cat {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .card-year {
    margin-left: auto;
    color: var(--ink);
    font-weight: 600;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--size-tile);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 32;
    text-wrap: balance;
  }

  .card-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* Stretch the title link over the whole card. The z-index lifts it above
     positioned children such as the problem block, while the actions row
     shares the same level and wins on document order. */
  .card-link::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: inherit;
  }

  .work-card:hover .card-link {
    color: var(--cobalt);
  }

  .card-subtitle {
    margin-top: calc(var(--space-2) * -1);
    color: var(--muted);
    font-weight: 500;
  }

  /* The problem statement: a tinted field, led in the same way as the role
     and outcome below it. */
  .card-problem {
    position: relative;
    width: 100%;
    padding: var(--space-4) var(--space-4);
    border-radius: var(--radius-m);
    background: var(--cobalt-tint);
  }

  .card-problem p {
    color: var(--ink);
    font-weight: 500;
    line-height: 1.5;
  }

  .card-problem strong {
    font-weight: 700;
  }

  /* Role in a narrow column, outcome in a wide one, each under its label. */
  .card-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: var(--space-4) var(--space-fluid-s);
    width: 100%;
  }

  .work-card.no-cover .card-facts {
    grid-template-columns: minmax(0, 1fr);
    max-width: var(--measure);
  }

  .card-facts dt {
    font-size: var(--size-label);
    font-weight: 600;
    color: var(--ink);
  }

  .card-facts dd {
    margin: var(--space-1) 0 0;
    color: var(--slate);
  }

  /* Sits above the stretched title link so the Live and Repo links stay
     clickable. The row itself takes no pointer events: it spans the full width
     of the body, and anything in it that is not a real link -- the call to
     action, the gaps -- would otherwise sit on top of the card link and
     swallow the click instead of opening the write-up. */
  .card-actions {
    position: relative;
    z-index: 1;
    pointer-events: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-1);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card-links a {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-s);
    background: var(--white);
    color: var(--ink);
    font-size: var(--size-label);
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .card-links a:hover {
    border-color: var(--cobalt);
    color: var(--cobalt);
  }

  .card-cta {
    padding-bottom: 2px;
    border-bottom: 2px solid var(--ink);
    color: var(--ink);
    font-weight: 600;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .work-card:hover .card-cta {
    color: var(--cobalt);
    border-color: var(--cobalt);
  }

  @media (max-width: 860px) {
    .work-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'cover'
        'head'
        'detail';
    }

    .card-facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
