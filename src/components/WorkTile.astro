---
import type { CollectionEntry } from 'astro:content';
import { WORK_TYPE_LABEL } from '../lib/work';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Heading level so the tile sits correctly under whatever heads its section. */
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const { title, name, type } = entry.data;
---

<a class="tile" href={`/work/${entry.id}`} data-type={type}>
  <span class="pill" data-type={type}>{WORK_TYPE_LABEL[type]}</span>
  <Heading>{title}</Heading>
  <span class="name label">{name}</span>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-height: 100%;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-tile);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
  }

  h2,
  h3 {
    font-family: var(--font-display);
    font-size: var(--size-tile);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .name {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .tile:hover h2,
  .tile:hover h3 {
    color: var(--cobalt);
  }
</style>
